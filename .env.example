# Production origin only, with HTTPS. Never use a temporary deployment URL.
SITE_URL=
# Leave false until the production launch is approved; rebuild after changing.
# Vercel Preview/Development and next dev remain noindex even if this is true.
SITE_INDEXING_ENABLED=false

# Server-only Resend credentials. Add actual values privately in Vercel or .env.local.
# Sender must use a domain verified in your Resend account; recipient is fixed in src/lib/site.ts.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=website@resend.getupcreative.com

# Public GA4 measurement ID. Regional rules and saved preferences gate loading.
NEXT_PUBLIC_GA_ID=G-ZZEW8FQTH5

# Server-only: enable only after verifying Vercel geolocation and proxy routing.
ANALYTICS_GEO_VERIFIED=false
# Comma-separated two-letter U.S. states approved for default-on analytics.
# For example GA,TX only after reviewing the actual GA configuration and applicable law.
# Blank or invalid configuration keeps all regions opt-in; no '*' wildcard.
ANALYTICS_US_DEFAULT_ON_STATES=
